@page "/forgot-password"
@using PropertyManagementSystem.Application.DTOs.Auth.Request
@using PropertyManagementSystem.UI.Components.Layout
@layout LandingLayout


<PageTitle>Forgot Password — Property Management System</PageTitle>

<RadzenStack AlignItems="AlignItems.Center" Style="width:100%">

    <RadzenCard Style="width:100%;max-width:420px;padding:2.5rem 2rem">

        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Gap="12px"
                     class="rz-mb-4">

            <RadzenIcon Icon="lock_reset"
                        Style="font-size:2.8rem;color:var(--rz-primary)" />

            <RadzenStack Gap="2px">
                <div class="rz-text-h6 rz-font-weight-bold">
                    Forgot Password
                </div>

                <div class="rz-text-secondary rz-text-sm">
                    We'll send a reset link to your email
                </div>
            </RadzenStack>

        </RadzenStack>

        @if (submitted)
        {
            <RadzenAlert AlertStyle="AlertStyle.Success"
                         Variant="Variant.Flat"
                         AllowClose="false">

                <RadzenStack Gap="4px">
                    <strong>Check your inbox</strong>
                    <span>If an account exists for <em>@sentEmail</em>, a reset link has been sent.</span>
                </RadzenStack>

            </RadzenAlert>

            <RadzenButton Text="Back to Sign In"
                          Icon="arrow_back"
                          ButtonStyle="ButtonStyle.Light"
                          Style="width:100%"
                          class="rz-mt-4"
                          Click="@(() => Nav.NavigateTo("/login"))" />
        }
        else
        {
            <RadzenTemplateForm TItem="ForgotPasswordRequestDto"
                                Data="@model"
                                Submit="@HandleSubmit">

                <RadzenStack Gap="16px">

                    <RadzenFormField Text="Email address"
                                     Variant="Variant.Outlined"
                                     Style="width:100%">

                        <ChildContent>
                            <RadzenTextBox @bind-Value="@model.Email"
                                           Name="Email"
                                           Placeholder="you@example.com"
                                           Style="width:100%" />
                        </ChildContent>

                        <Helper>
                            <RadzenRequiredValidator Component="Email"
                                                     Text="Email is required" />

                            <RadzenEmailValidator Component="Email"
                                                  Text="Enter a valid email address" />
                        </Helper>

                    </RadzenFormField>

                    <RadzenButton ButtonType="ButtonType.Submit"
                                  Text="Send Reset Link"
                                  Icon="send"
                                  Style="width:100%"
                                  IsBusy="@isLoading"
                                  BusyText="Sending..." />

                </RadzenStack>

            </RadzenTemplateForm>

            <RadzenStack AlignItems="AlignItems.Center" class="rz-mt-4">
                <RadzenLink Text="Back to Sign In" Path="/login" />
            </RadzenStack>
        }

    </RadzenCard>

</RadzenStack>