@page "/profile"

<PageTitle>My Profile — PMS</PageTitle>

<RadzenStack Gap="1.25rem" Style="max-width:1200px; margin:0 auto;">
    <RadzenLabel Title="My Profile" Icon="manage_accounts" Subtitle="Update your personal information" />

    @if (isLoading)
    {
        <div style="display:flex;align-items:center;justify-content:center;height:20vh">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        </div>
    }
    else
    {
        <RadzenCard>
            <h4>Personal Information</h4>

            <RadzenStack Gap="0.5rem">
                <div><b>Name:</b> @user.Name</div>
                <div><b>Email:</b> @user.Email</div>
                <div><b>Role:</b> @user.Role</div>
            </RadzenStack>

            <RadzenButton Text="Edit Profile"
                          Icon="edit"
                          Style="margin-top:1rem"
                          Click="@OpenEditProfileDialog" />
        </RadzenCard>

        <hr />

        <RadzenCard>
            <h4>Security</h4>

            <RadzenButton Text="Change Password"
                          Icon="lock_reset"
                          ButtonStyle="ButtonStyle.Secondary"
                          Click="@OpenChangePasswordDialog" />
        </RadzenCard>
    }
</RadzenStack>