@using Radzen
@inherits LayoutComponentBase

<RadzenComponents @rendermode="InteractiveServer" />

<RadzenLayout Style="height:100vh">

    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.SpaceBetween"
                     Style="width:100%">

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="10px">
                <RadzenSidebarToggle Click="@(() => sidebar1Expanded = !sidebar1Expanded)" />
                <RadzenLabel Text="PMS" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="15px">
                <RadzenAppearanceToggle />

                @* <RadzenButton ButtonStyle="ButtonStyle.Light"
                              Style="position:relative; padding:6px;"
                              Click="@ToggleNotifications">

                    <RadzenIcon Icon="notifications" Style="font-size:20px;" />

                    @if (NotificationService.UnreadCount > 0)
                    {
                        <RadzenBadge Text="@NotificationService.UnreadCount.ToString()"
                                     Style="position:absolute; top:-5px; right:-5px;" />
                    }
                </RadzenButton> *@

                @* <RadzenButton Text="Logout" Icon="logout" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Click="@GoToLogout" /> *@
            </RadzenStack>

        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="@sidebar1Expanded">
        <NavMenu />
    </RadzenSidebar>

    <RadzenBody>
        @Body
    </RadzenBody>

</RadzenLayout>