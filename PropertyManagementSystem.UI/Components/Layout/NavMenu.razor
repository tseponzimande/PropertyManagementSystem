@using Microsoft.AspNetCore.Components.Authorization

<div class="nav-scrollable">
    <nav class="flex-column">

        <RadzenPanelMenu Multiple="false">

            <RadzenPanelMenuItem Text="Dashboard" Path="/dashboard" Icon="dashboard" />

            <RadzenPanelMenuItem Text="Account" Icon="account_circle">

                <AuthorizeView>
                    <Authorized>
                        <RadzenPanelMenuItem Text="Logout" Icon="logout" Click="@Logout" />
                    </Authorized>

                    <NotAuthorized>
                        <RadzenPanelMenuItem Text="Login" Icon="login" Path="/login" />
                    </NotAuthorized>
                </AuthorizeView>

            </RadzenPanelMenuItem>

        </RadzenPanelMenu>

    </nav>
</div>

@code {
    [Inject] 
    private AuthStateService AuthStateService { get; set; } = null!;

    [Inject] 
    private NavigationManager Navigation { get; set; } = null!;

    private async Task Logout()
    {
        await AuthStateService.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }
}