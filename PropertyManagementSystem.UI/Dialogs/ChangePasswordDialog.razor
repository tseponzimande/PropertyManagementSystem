@using Radzen.Blazor

<RadzenCard Style="width:400px">
    <h4>Change Password</h4>

    <RadzenTemplateForm TItem="ChangePasswordRequestDto" Data="@pwdModel" Submit="@SavePassword">
        <RadzenStack Gap="1rem">

            <RadzenFormField Text="Current Password" Style="width:100%">
                <ChildContent>
                    <RadzenPassword @bind-Value="@pwdModel.OldPassword" Name="OldPassword" Style="width:100%" />
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="OldPassword" Text="Current password required" />
                </Helper>
            </RadzenFormField>

            <RadzenFormField Text="New Password" Style="width:100%">
                <ChildContent>
                    <RadzenPassword @bind-Value="@pwdModel.NewPassword" Name="NewPassword" Style="width:100%" />
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="NewPassword" Text="New password required" />
                    <RadzenLengthValidator Component="NewPassword" Min="8" Text="Minimum 8 characters" />
                </Helper>
            </RadzenFormField>

            <RadzenFormField Text="Confirm New Password" Style="width:100%">
                <ChildContent>
                    <RadzenPassword @bind-Value="@pwdModel.ConfirmPassword" Name="ConfirmPwd" Style="width:100%" />
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="ConfirmPwd" Text="Please confirm password" />
                    <RadzenCompareValidator Component="ConfirmPwd" Value="@pwdModel.NewPassword" Text="Passwords do not match" />
                </Helper>
            </RadzenFormField>

            @if (!string.IsNullOrEmpty(error))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@error</RadzenAlert>
            }

            <RadzenButton ButtonType="ButtonType.Submit"
                          Text="Update Password"
                          Icon="lock_reset"
                          ButtonStyle="ButtonStyle.Primary"
                          IsBusy="@loading" BusyText="Updating..." />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenCard>